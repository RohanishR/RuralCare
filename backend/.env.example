PROJECT_NAME=RuralCare API
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ruralcare

# Authentication — required for the running backend
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=
TRANSLATION_API_KEY=

# On Vercel set these in Project Settings, not in a committed .env:
# FRONTEND_URL=https://ruralcare-cyan.vercel.app
# MONGODB_URI=<full Atlas connection string>
# DATABASE_NAME=<existing production database name>
# SECRET_KEY=<existing strong signing secret>
